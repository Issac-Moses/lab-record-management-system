# =============================================================================
# .env.example — Lab Record System
#
# IMPORTANT: This file is safe to commit to Git.
#            Copy it to ".env" for local development ONLY.
#            In production (Coolify), set these in the UI → Environment Variables.
#            NEVER commit a real .env file with secrets to Git.
# =============================================================================

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project → Project Settings → API

# URL of your Supabase project
SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe to expose in browser)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — KEEP SECRET, backend only, never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Frontend (Vite build-time variables) ─────────────────────────────────────
# These are baked into the JS bundle at build time.
# They must be set as Docker build args in Coolify.

# Same as SUPABASE_URL (Vite needs VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Same as SUPABASE_ANON_KEY (Vite needs VITE_ prefix)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base URL for all API calls from the React app.
# In production: your domain (Nginx proxies /api/* and /run to backend)
# In local dev: http://localhost:7001
VITE_MANUAL_API_URL=https://labmanagementportal.xyz

# Optional: Proctor AI service URL
VITE_PROCTOR_API_URL=

# Optional: Mark limits
VITE_INTERNAL_EXPERIMENT_MAX_MARK=10
VITE_INTERNAL_MARKS_MAX=20

# ─── Backend Server ───────────────────────────────────────────────────────────

# Port the Express server listens on
RUNNER_PORT=7001

# Node environment
NODE_ENV=production

# ─── Code Execution Strategy ─────────────────────────────────────────────────
# auto   = try host Docker first, fall back to Piston/Judge0 cloud APIs
# piston = always use Piston cloud API (no Docker socket needed)
# docker = always use host Docker socket (requires /var/run/docker.sock)
CODE_RUNNER=piston

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# Since Nginx proxies on the same domain, CORS is rarely triggered in prod.
CORS_ORIGINS=https://labmanagementportal.xyz

# Set to 1 to trust X-Forwarded-For from Nginx/Traefik reverse proxy.
# Required for correct IP-based rate limiting in production.
TRUST_PROXY=1

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
# NEVER prefix with VITE_ — backend only
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Optional Tuning ─────────────────────────────────────────────────────────
# JSON_BODY_LIMIT=10mb
# RATE_LIMIT_GLOBAL_MAX=5000
# RATE_LIMIT_RUN_MAX=60
# DOCKER_RUN_TIMEOUT_MS=180000
